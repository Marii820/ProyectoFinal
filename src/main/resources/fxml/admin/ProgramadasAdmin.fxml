<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.proyectofinal.proyectofinal.vista.admin.ProgramadasAdminController"
      spacing="14" stylesheets="@../../estilos.css">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <children>
        <Label styleClass="titulo" text="Operaciones programadas"/>
        <VBox spacing="10" styleClass="tarjeta">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <children>
                <Label fx:id="lblReloj" styleClass="subtitulo"/>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <children>
                        <Label text="Adelantar"/>
                        <Spinner fx:id="spHoras" editable="true" prefWidth="90"/>
                        <Label text="horas"/>
                        <Button onAction="#avanzar" styleClass="primario" text="Simular paso del tiempo"/>
                        <Button onAction="#procesar" text="Procesar vencidas ahora"/>
                    </children>
                </HBox>
                <Label styleClass="ayuda" wrapText="true"
                       text="La aplicación revisa sola cada 20 segundos si hay programadas vencidas. Con &quot;Simular paso del tiempo&quot; se adelanta el reloj del sistema para ver cómo se ejecutan en orden de fecha (y por nivel cuando coinciden), cómo se reprograman las recurrentes y cómo se rechazan las que no tienen saldo."/>
            </children>
        </VBox>
        <VBox spacing="10" styleClass="tarjeta" VBox.vgrow="ALWAYS">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <children>
                <Label styleClass="subtitulo" text="Cola de prioridad (montículo): la primera fila es la próxima en salir"/>
                <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colOrden" prefWidth="55" text="Orden"/>
                        <TableColumn fx:id="colId" prefWidth="60" text="ID"/>
                        <TableColumn fx:id="colFecha" prefWidth="130" text="Ejecución"/>
                        <TableColumn fx:id="colPrioridad" prefWidth="85" text="Prioridad"/>
                        <TableColumn fx:id="colUsuario" prefWidth="190" text="Usuario"/>
                        <TableColumn fx:id="colTipo" prefWidth="160" text="Tipo"/>
                        <TableColumn fx:id="colValor" prefWidth="100" text="Valor"/>
                        <TableColumn fx:id="colRuta" prefWidth="180" text="Origen → destino"/>
                        <TableColumn fx:id="colFrecuencia" prefWidth="90" text="Frecuencia"/>
                        <TableColumn fx:id="colResultados" prefWidth="80" text="OK / fallos"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
