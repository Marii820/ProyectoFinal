<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.proyectofinal.proyectofinal.vista.admin.UsuariosController"
      spacing="16" stylesheets="@../../estilos.css">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <children>
        <Label styleClass="titulo" text="Usuarios"/>
        <VBox spacing="10" styleClass="tarjeta" VBox.vgrow="ALWAYS">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <children>
                        <TextField fx:id="txtBuscar" prefWidth="220" promptText="Cédula, celular o correo"/>
                        <Button onAction="#buscar" styleClass="primario" text="Buscar (tabla hash)"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#eliminar" styleClass="peligro" text="Eliminar usuario seleccionado"/>
                    </children>
                </HBox>
                <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCedula" prefWidth="110" text="Cédula"/>
                        <TableColumn fx:id="colNombre" prefWidth="170" text="Nombre"/>
                        <TableColumn fx:id="colCorreo" prefWidth="190" text="Correo"/>
                        <TableColumn fx:id="colCelular" prefWidth="100" text="Celular"/>
                        <TableColumn fx:id="colNivel" prefWidth="80" text="Nivel"/>
                        <TableColumn fx:id="colPuntos" prefWidth="80" text="Puntos"/>
                        <TableColumn fx:id="colDisponible" prefWidth="110" text="Disponible"/>
                        <TableColumn fx:id="colEnBilleteras" prefWidth="110" text="En billeteras"/>
                        <TableColumn fx:id="colRegistro" prefWidth="125" text="Registro"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
        <VBox spacing="8" styleClass="tarjeta">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <children>
                <Label fx:id="lblDetalle" styleClass="subtitulo" text="Cuentas del usuario"/>
                <TableView fx:id="tablaCuentas" prefHeight="180">
                    <columns>
                        <TableColumn fx:id="colCtaCodigo" prefWidth="120" text="Código"/>
                        <TableColumn fx:id="colCtaNombre" prefWidth="160" text="Nombre"/>
                        <TableColumn fx:id="colCtaTipo" prefWidth="140" text="Tipo"/>
                        <TableColumn fx:id="colCtaSaldo" prefWidth="110" text="Saldo"/>
                        <TableColumn fx:id="colCtaEstado" prefWidth="90" text="Estado"/>
                        <TableColumn fx:id="colCtaMovs" prefWidth="90" text="Movimientos"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
        <VBox spacing="4" styleClass="tarjeta">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <children>
                <Label styleClass="subtitulo" text="Estado de las tablas hash"/>
                <Label fx:id="lblHash" styleClass="ayuda" wrapText="true"/>
            </children>
        </VBox>
    </children>
</VBox>
