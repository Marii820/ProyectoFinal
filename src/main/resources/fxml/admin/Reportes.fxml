<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.proyectofinal.proyectofinal.vista.admin.ReportesController"
            fitToWidth="true" stylesheets="@../../estilos.css">
    <content>
        <VBox spacing="16">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <children>
                <Label styleClass="titulo" text="4.8 Analítica de movimientos"/>
                <Label styleClass="ayuda" wrapText="true"
                       text="Consultas e informes del enunciado: (1) billeteras con mayor uso, (2) usuarios con más transferencias realizadas, (3) categorías de billetera más activas, (4) patrones de movimiento entre usuarios, (5) frecuencia de transacciones por tipo y (6) monto total movilizado en un rango de tiempo. Escoja el rango de fechas y presione Generar."/>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <children>
                        <Label text="Desde"/>
                        <DatePicker fx:id="dpDesde"/>
                        <Label text="hasta"/>
                        <DatePicker fx:id="dpHasta"/>
                        <Button onAction="#generar" styleClass="primario" text="Generar reportes"/>
                    </children>
                </HBox>

                <HBox spacing="16">
                    <children>
                        <VBox spacing="4" styleClass="tarjeta">
                            <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
                            <children>
                                <Label styleClass="ayuda" text="(6) Monto total movilizado en el rango"/>
                                <Label fx:id="lblMonto" styleClass="kpi" text="\$0"/>
                            </children>
                        </VBox>
                        <VBox spacing="4" styleClass="tarjeta">
                            <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
                            <children>
                                <Label styleClass="ayuda" text="Transacciones exitosas"/>
                                <Label fx:id="lblCantidad" styleClass="kpi" text="0"/>
                            </children>
                        </VBox>
                        <VBox spacing="4" styleClass="tarjeta">
                            <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
                            <children>
                                <Label styleClass="ayuda" text="Usuario con mayor actividad"/>
                                <Label fx:id="lblActivo" styleClass="kpi" text="-"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <GridPane hgap="16" vgap="16">
                    <children>
                        <VBox spacing="8" styleClass="tarjeta" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                            <children>
                                <Label styleClass="subtitulo" text="(1) Billeteras con mayor uso"/>
                                <TableView fx:id="tCuentas" prefHeight="230" prefWidth="500"/>
                            </children>
                        </VBox>
                        <VBox spacing="8" styleClass="tarjeta" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                            <children>
                                <Label styleClass="subtitulo" text="(2) Usuarios con más transferencias realizadas"/>
                                <TableView fx:id="tUsuarios" prefHeight="230" prefWidth="500"/>
                            </children>
                        </VBox>
                        <VBox spacing="8" styleClass="tarjeta" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                            <children>
                                <Label styleClass="subtitulo" text="(3) Categorías de billetera más activas"/>
                                <TableView fx:id="tCategorias" prefHeight="230" prefWidth="500"/>
                            </children>
                        </VBox>
                        <VBox spacing="8" styleClass="tarjeta" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                            <children>
                                <Label styleClass="subtitulo" text="(4) Patrones de movimiento entre usuarios (grafo)"/>
                                <TableView fx:id="tPatrones" prefHeight="150" prefWidth="500"/>
                                <Label styleClass="ayuda" text="Ciclos: el dinero sale de alguien y le vuelve a llegar"/>
                                <ListView fx:id="lvCiclos" prefHeight="70"/>
                            </children>
                        </VBox>
                        <VBox spacing="8" styleClass="tarjeta" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                            <children>
                                <Label styleClass="subtitulo" text="(5) Frecuencia de transacciones por tipo"/>
                                <TableView fx:id="tTipos" prefHeight="230" prefWidth="500"/>
                            </children>
                        </VBox>
                    </children>
                </GridPane>

                <VBox spacing="8" styleClass="tarjeta">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <children>
                                <Label styleClass="subtitulo" text="Transacciones de mayor valor (árbol binario por valor)"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Top"/>
                                <Spinner fx:id="spTop" prefWidth="80"/>
                            </children>
                        </HBox>
                        <TableView fx:id="tTop" prefHeight="260">
                            <columns>
                                <TableColumn fx:id="colTopId" prefWidth="70" text="ID"/>
                                <TableColumn fx:id="colTopFecha" prefWidth="125" text="Fecha"/>
                                <TableColumn fx:id="colTopTipo" prefWidth="170" text="Tipo"/>
                                <TableColumn fx:id="colTopValor" prefWidth="110" text="Valor"/>
                                <TableColumn fx:id="colTopUsuario" prefWidth="200" text="Usuario"/>
                                <TableColumn fx:id="colTopRuta" prefWidth="200" text="Origen → destino"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
                <Label styleClass="ayuda" wrapText="true"
                       text="Los conteos (1, 2, 3, 5) se hacen con la tabla hash propia (clave → acumulado) y se ordenan con la lista enlazada; los patrones (4) salen del grafo de transferencias; el top sale del árbol binario ordenado por valor. Solo se cuentan operaciones exitosas (no rechazadas ni revertidas). Más análisis del grafo en la sección Grafo."/>
            </children>
        </VBox>
    </content>
</ScrollPane>
