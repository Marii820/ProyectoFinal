<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.proyectofinal.proyectofinal.vista.admin.GrafoController"
            fitToWidth="true" stylesheets="@../../estilos.css">
    <content>
        <VBox spacing="16">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
            <children>
                <Label styleClass="titulo" text="Grafo de transferencias"/>
                <VBox spacing="10" styleClass="tarjeta">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <children>
                        <Label styleClass="subtitulo" text="Transferencias entre usuarios (patrones de interacción)"/>
                        <Label fx:id="lblResumen" styleClass="ayuda"/>
                        <Label text="Rutas más frecuentes (aristas con más peso):"/>
                        <TableView fx:id="tRutas" prefHeight="200">
                            <columns>
                                <TableColumn fx:id="colRutaOrigen" prefWidth="220" text="Quién envía"/>
                                <TableColumn fx:id="colRutaDestino" prefWidth="220" text="Quién recibe"/>
                                <TableColumn fx:id="colRutaVeces" prefWidth="70" text="Veces"/>
                                <TableColumn fx:id="colRutaMonto" prefWidth="120" text="Monto total"/>
                            </columns>
                        </TableView>
                        <Label text="Ciclos detectados con DFS (el dinero vuelve al origen):"/>
                        <ListView fx:id="lvCiclos" prefHeight="150"/>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <children>
                                <ComboBox fx:id="cbDesde" prefWidth="220" promptText="Desde"/>
                                <ComboBox fx:id="cbHasta" prefWidth="220" promptText="Hasta"/>
                                <Button onAction="#buscarRuta" text="Buscar ruta (BFS)"/>
                            </children>
                        </HBox>
                        <Label fx:id="lblRuta" wrapText="true"/>
                        <Label fx:id="lblAlcance" styleClass="ayuda" wrapText="true"/>
                    </children>
                </VBox>
                <VBox spacing="10" styleClass="tarjeta">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <children>
                        <Label styleClass="subtitulo" text="Relaciones entre cuentas y billeteras"/>
                        <Label styleClass="ayuda" text="Incluye los movimientos entre el Disponible y las billeteras de un mismo usuario."/>
                        <TableView fx:id="tCuentas" prefHeight="200">
                            <columns>
                                <TableColumn fx:id="colCtaOrigen" prefWidth="240" text="Cuenta origen"/>
                                <TableColumn fx:id="colCtaDestino" prefWidth="240" text="Cuenta destino"/>
                                <TableColumn fx:id="colCtaVeces" prefWidth="70" text="Veces"/>
                                <TableColumn fx:id="colCtaMonto" prefWidth="120" text="Monto total"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
                <Label styleClass="ayuda" wrapText="true"
                       text="Grafo dirigido y ponderado con listas de adyacencia (TablaHash vértice → lista de aristas). El peso de cada arista es cuántas veces se ha transferido y cuánto dinero ha pasado."/>
            </children>
        </VBox>
    </content>
</ScrollPane>
