<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.proyectofinal.proyectofinal.vista.cliente.NotificacionesController"
      spacing="14" stylesheets="@../../estilos.css">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <children>
        <Label styleClass="titulo" text="Notificaciones"/>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>
                <Label fx:id="lblInfo" styleClass="ayuda"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#marcarLeidas" text="Marcar todas como leídas"/>
            </children>
        </HBox>
        <ListView fx:id="lista" VBox.vgrow="ALWAYS"/>
    </children>
</VBox>
