<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.proyectofinal.proyectofinal.vista.cliente.ProgramadasController"
      spacing="16" stylesheets="@../../estilos.css">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <children>
        <Label styleClass="titulo" text="Operaciones programadas"/>

        <VBox spacing="12" styleClass="tarjeta">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <children>
                <GridPane hgap="12" vgap="10">
                    <children>
                        <Label text="Tipo:" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="cbTipo" prefWidth="260" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Descripción:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtDescripcion" prefWidth="260" promptText="Ej: Arriendo, Netflix, ahorro" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <Label fx:id="lblOrigen" text="Desde:" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="cbOrigen" prefWidth="260" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label fx:id="lblDestino" text="Hacia:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <HBox GridPane.columnIndex="3" GridPane.rowIndex="1">
                            <children>
                                <ComboBox fx:id="cbDestinoPropio" prefWidth="260"/>
                                <TextField fx:id="txtDestinatario" prefWidth="260" promptText="Cédula, celular o correo"/>
                            </children>
                        </HBox>

                        <Label text="Valor:" GridPane.rowIndex="2"/>
                        <TextField fx:id="txtValor" prefWidth="200" promptText="\$ valor" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="Frecuencia:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                        <ComboBox fx:id="cbFrecuencia" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                        <Label text="Primera vez:" GridPane.rowIndex="3"/>
                        <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="3">
                            <children>
                                <DatePicker fx:id="dpFecha" prefWidth="170"/>
                                <TextField fx:id="txtHora" prefWidth="70" promptText="HH:mm" text="08:00"/>
                            </children>
                        </HBox>
                    </children>
                </GridPane>
                <Button onAction="#programar" styleClass="primario" text="Programar"/>
            </children>
        </VBox>

        <VBox spacing="10" styleClass="tarjeta" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <children>
                <Label styleClass="subtitulo" text="Mis operaciones programadas (en el orden en que se van a ejecutar)"/>
                <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFecha" prefWidth="130" text="Próxima ejecución"/>
                        <TableColumn fx:id="colDescripcion" prefWidth="160" text="Descripción"/>
                        <TableColumn fx:id="colTipo" prefWidth="160" text="Tipo"/>
                        <TableColumn fx:id="colValor" prefWidth="100" text="Valor"/>
                        <TableColumn fx:id="colDesde" prefWidth="110" text="Desde"/>
                        <TableColumn fx:id="colHacia" prefWidth="130" text="Hacia"/>
                        <TableColumn fx:id="colFrecuencia" prefWidth="100" text="Frecuencia"/>
                        <TableColumn fx:id="colResultados" prefWidth="110" text="Hechas / fallidas"/>
                    </columns>
                </TableView>
                <Button onAction="#cancelar" styleClass="peligro" text="Cancelar la seleccionada"/>
                <Label fx:id="lblAyuda" styleClass="ayuda" wrapText="true"/>
            </children>
        </VBox>
    </children>
</VBox>
