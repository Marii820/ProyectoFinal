<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.proyectofinal.proyectofinal.vista.cliente.RecompensasController"
      spacing="16" stylesheets="@../../estilos.css">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <children>
        <Label styleClass="titulo" text="Recompensas"/>
        <HBox spacing="16" VBox.vgrow="ALWAYS">
            <children>
                <VBox prefWidth="420" spacing="8" styleClass="tarjeta">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                    <children>
                        <Label fx:id="lblNivel" styleClass="nivel-grande" text="Nivel"/>
                        <Label fx:id="lblPuntos" styleClass="subtitulo"/>
                        <ProgressBar fx:id="progreso" prefWidth="380" progress="0.0"/>
                        <Label fx:id="lblProgreso"/>
                        <Label styleClass="subtitulo" text="Tus ventajas"/>
                        <Label fx:id="lblVentajas" wrapText="true"/>
                        <Label fx:id="lblRanking" styleClass="ayuda"/>
                        <Label styleClass="ayuda" wrapText="true"
                               text="Bronce 0-500 · Plata 501-1.000 · Oro 1.001-5.000 · Platino más de 5.000 puntos acumulados. Canjear no te baja de nivel; revertir una operación sí descuenta sus puntos."/>
                    </children>
                </VBox>
                <VBox spacing="10" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                    <children>
                        <Label styleClass="subtitulo" text="Catálogo de beneficios"/>
                        <TableView fx:id="tabla" prefHeight="220">
                            <columns>
                                <TableColumn fx:id="colNombre" prefWidth="160" text="Beneficio"/>
                                <TableColumn fx:id="colDetalle" prefWidth="230" text="Detalle"/>
                                <TableColumn fx:id="colPuntos" prefWidth="80" text="Puntos"/>
                                <TableColumn fx:id="colNivel" prefWidth="90" text="Desde nivel"/>
                                <TableColumn fx:id="colDisponible" prefWidth="80" text="¿Alcanza?"/>
                            </columns>
                        </TableView>
                        <Button onAction="#canjear" styleClass="primario" text="Canjear seleccionado"/>
                        <Label styleClass="subtitulo" text="Mis beneficios canjeados"/>
                        <ListView fx:id="lvCanjeados" prefHeight="150" VBox.vgrow="ALWAYS"/>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
