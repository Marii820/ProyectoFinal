<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.edu.uniquindio.proyectofinal.proyectofinal.vista.acceso.IngresoController"
           styleClass="fondo-acceso" stylesheets="@../estilos.css" prefWidth="1280" prefHeight="800">
    <children>
        <VBox maxHeight="-Infinity" maxWidth="420" spacing="12" styleClass="caja-acceso">
            <padding>
                <Insets top="36" right="36" bottom="36" left="36"/>
            </padding>
            <children>
                <Label styleClass="logo-pequeno" text="QuindiPay"/>
                <Label styleClass="titulo" text="Ingresa a tu cuenta"/>
                <Label text="Cédula, celular o correo"/>
                <TextField fx:id="txtUsuario" promptText="Ej: 1094000001"/>
                <Label text="Contraseña"/>
                <PasswordField fx:id="txtClave" promptText="Tu contraseña"/>
                <Label fx:id="lblError" styleClass="texto-error" wrapText="true"/>
                <Button defaultButton="true" maxWidth="Infinity" onAction="#entrar" styleClass="primario,boton-grande" text="Entrar"/>
                <HBox spacing="10">
                    <children>
                        <Hyperlink onAction="#volver" text="← Volver"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Hyperlink onAction="#irRegistro" text="¿No tienes cuenta? Regístrate"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
