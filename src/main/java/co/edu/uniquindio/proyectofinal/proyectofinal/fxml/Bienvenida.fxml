<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.edu.uniquindio.proyectofinal.proyectofinal.vista.acceso.BienvenidaController"
           styleClass="fondo-acceso" stylesheets="@../estilos.css" prefWidth="1280" prefHeight="800">
    <children>
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="420" spacing="18" styleClass="caja-acceso">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>
            <children>
                <Label styleClass="logo" text="QuindiPay"/>
                <Label styleClass="eslogan" text="Tu plata organizada: un Disponible para el día a día y billeteras para separar lo que quieras." wrapText="true"/>
                <Button defaultButton="true" maxWidth="Infinity" onAction="#ingresar" styleClass="primario,boton-grande" text="Ingresar"/>
                <Button maxWidth="Infinity" onAction="#registrarme" styleClass="secundario,boton-grande" text="Registrarme"/>
            </children>
        </VBox>
    </children>
</StackPane>
