<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.proyectofinal.proyectofinal.vista.cliente.InicioController"
            fitToWidth="true" stylesheets="@../../estilos.css">
    <content>
        <HBox spacing="20">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <children>
                <!-- ========== columna izquierda ========== -->
                <VBox spacing="16" HBox.hgrow="ALWAYS">
                    <children>
                        <!-- Disponible (cuenta principal): al darle clic se abre "Mi cuenta" -->
                        <VBox onMouseClicked="#irCuenta" spacing="6" styleClass="banner-saldo,tarjeta-click">
                            <padding>
                                <Insets top="22" right="22" bottom="22" left="22"/>
                            </padding>
                            <children>
                                <HBox>
                                    <children>
                                        <Label styleClass="ayuda-clara" text="Disponible"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label styleClass="ayuda-clara" text="Ver mi cuenta ›"/>
                                    </children>
                                </HBox>
                                <Label fx:id="lblDisponible" styleClass="saldo-grande" text="\$0"/>
                                <Label fx:id="lblResumen" styleClass="ayuda-clara" text="En bolsillos: $0 · Total: $0"/>
                                <HBox spacing="10">
                                    <children>
                                        <Button onAction="#irRecargar" styleClass="boton-claro" text="Recargar"/>
                                        <Button onAction="#irEnviar" styleClass="boton-claro" text="Transferir plata"/>
                                        <Button onAction="#irRetirar" styleClass="boton-claro" text="Retirar"/>
                                        <Button onAction="#irProgramar" styleClass="boton-claro" text="Programar pago"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label styleClass="subtitulo" text="Mis bolsillos"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Hyperlink onAction="#irCuenta" text="Crear o administrar bolsillos ›"/>
                            </children>
                        </HBox>
                        <FlowPane fx:id="tarjetas" hgap="16" prefWrapLength="700" vgap="16"/>
                        <Label fx:id="lblSinBilleteras" styleClass="ayuda" wrapText="true"
                               text="Todavía no tienes bolsillos. Dale clic a tu Disponible para crear el primero."/>
                    </children>
                </VBox>

                <!-- ========== columna derecha ========== -->
                <VBox minWidth="300" prefWidth="340" spacing="14">
                    <children>
                        <VBox spacing="8" styleClass="tarjeta">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>
                            <children>
                                <Label styleClass="subtitulo" text="Últimos movimientos"/>
                                <VBox fx:id="ultimos" spacing="6"/>
                            </children>
                        </VBox>
                        <VBox spacing="8" styleClass="tarjeta">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>
                            <children>
                                <Label styleClass="subtitulo" text="Próximas programadas"/>
                                <VBox fx:id="proximas" spacing="6"/>
                            </children>
                        </VBox>
                        <VBox spacing="8" styleClass="tarjeta">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>
                            <children>
                                <Label styleClass="subtitulo" text="Alertas sin leer"/>
                                <VBox fx:id="alertas" spacing="6"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </content>
</ScrollPane>
